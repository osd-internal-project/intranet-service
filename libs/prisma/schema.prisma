generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["interactiveTransactions"]
    binaryTargets   = ["native"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model dataLeaveFiles {
    id          Int        @unique @default(autoincrement())
    fileCode    String?    @map("file_code") @db.VarChar(200)
    path        String?    @db.VarChar(200)
    fileName    String?    @map("file_name") @db.VarChar(200)
    fileType    String?    @map("file_type") @db.VarChar(200)
    type        String?    @db.VarChar(10)
    createdAt   DateTime   @default(now())
    updatedAt   DateTime?  @db.Timestamp()
    dataLeave   dataLeave? @relation(fields: [dataLeaveId], references: [id])
    dataLeaveId Int?       @map("data_leave_id")

    @@map("data_leave_file")
}

model dataLeave {
    id             Int              @unique @default(autoincrement()) @map("id")
    userId         String?          @map("user_id") @db.VarChar(100)
    firstName      String?          @default("") @map("first_name") @db.VarChar(100)
    lastName       String?          @default("") @map("last_name") @db.VarChar(100)
    positionId     Int?             @map("position_id") @db.Integer
    position       String?          @default("") @map("position") @db.VarChar(100)
    typeId         Int?             @map("type_id") @db.Integer
    typeName       String?          @default("") @map("type_name") @db.VarChar(100)
    startDate      DateTime?        @default(now()) @map("start_date") @db.Timestamp()
    startTime      String?          @map("start_time") @db.VarChar(10)
    endDate        DateTime?        @default(now()) @map("end_date") @db.Timestamp()
    endTime        String?          @map("end_time") @db.VarChar(10)
    leaveHour      Float?           @default(0.00) @map("leave_hour")
    detail         String?          @default("") @map("detail") @db.Text
    phoneNumber    String           @default("") @map("phone_number") @db.VarChar(50)
    status         String?          @default("") @map("status") @db.VarChar(50)
    approvedDate   DateTime?        @map("approved_date") @db.Timestamp()
    userApproved   String?          @map("user_approved") @db.VarChar(100)
    attrachFile    String?          @map("attrach_file") @db.VarChar(250)
    createdAt      DateTime?        @default(now()) @map("created_at") @db.Timestamp()
    updatedAt      DateTime?        @default(now()) @map("updated_at") @db.Timestamp()
    ownerId        String?          @default("") @map("owner_id") @db.VarChar(100)
    ownerName      String?          @default("") @map("owner_name") @db.VarChar(150)
    groupId        String?          @default("") @map("group_id") @db.VarChar(100)
    dataLeaveFiles dataLeaveFiles[]

    @@map("data_leave")
}

model informationNews {
    newsId      Int         @unique @default(autoincrement()) @map("news_id")
    newsName    String?     @default("") @map("news_name")
    content     String?     @default("") @map("content")
    newsType    String?     @default("") @map("new_Type")
    author      String?     @default("") @map("author") @db.VarChar(100)
    phblishedAt DateTime?   @default(now()) @map("phblished_at")
    updatedAt   DateTime?   @map("updated_at")
    status      Boolean?    @default(true) @map("status") @db.Boolean
    newsImage   newsImage[]

    @@map("information_news")
}

model newsType {
    idType    Int       @unique @default(autoincrement()) @map("idType")
    nameType  String?   @default("") @map("nameType")
    deteil    String?   @default("") @map("dedeil")
    createAt  DateTime? @default(now()) @map("createAt")
    updatedAt DateTime? @default(now()) @map("updated_At")
    status    Boolean?  @default(true) @map("status") @db.Boolean

    @@map("news_type")
}

model newsImage {
    imageId         Int              @unique @default(autoincrement()) @map("image_id")
    createdAt       DateTime?        @default(now()) @map("createdat")
    updatedAt       DateTime?        @default(now()) @map("updatedat")
    fileimageName   String?          @default("") @map("file_image_name") @db.VarChar(100)
    fileimagePath   String?          @default("") @map("file_image_path") @db.VarChar(100)
    fileName        String?          @default("") @map("file_name") @db.VarChar(100)
    informationNews informationNews? @relation(fields: [newsId], references: [newsId])
    newsId          Int?             @map("news_id")

    @@map("news_image")
}

model handbooktype {
    idhandtype Int       @unique @default(autoincrement()) @map("id_handtype")
    nameType   String?   @default("") @map("name_Type")
    createAt   DateTime? @default(now()) @map("create_At")
    updatedAt  DateTime? @default(now()) @map("updated_At")
    author     String?   @default("") @map("author") @db.VarChar(100)
    status     Boolean?  @default(true) @map("status") @db.Boolean

    @@map("handbook_type")
}

model handbookFile {
    handbookid       Int       @unique @default(autoincrement()) @map("handbook_id")
    fileId           String    @default(uuid()) @map("file_id") @db.VarChar(50)
    fileName         String?   @default("") @map("file_name") @db.VarChar(200)
    filetype         String?   @default("") @map("file_type") @db.VarChar(200)
    fileoriginalName String?   @default("") @map("file_origina_name") @db.VarChar(200)
    fileLocation     String?   @default("") @map("file_location") @db.VarChar(100)
    author           String?   @default("") @map("author") @db.VarChar(100)
    createdAt        DateTime? @default(now()) @map("created_At")
    updatedAt        DateTime? @default(now()) @map("updated_At")
    status           Boolean?  @default(true) @map("status") @db.Boolean
    // handbook         handbook? @relation(fields: [idbook], references: [idbook])
    // idbook           Int? Z     @map("id_book")

    @@map("handbook_file")
}

model emailTemplate {
    id                Int                @unique @default(autoincrement()) @map("id")
    templateId        String             @unique @default(uuid()) @map("template_id")
    name              String             @default("") @map("name") @db.VarChar(100)
    type              Int                @map("type") @db.Integer
    status            String             @default("Inactive") @map("status") @db.VarChar(10)
    htmlTemplate      String             @default("") @map("html_template") @db.Text
    used              Boolean            @default(false) @map("used") @db.Boolean
    createAt          DateTime?          @default(now()) @map("created_at") @db.Timestamptz()
    updateAt          DateTime?          @default(now()) @map("updated_at") @db.Timestamptz()
    emailTemplateType emailTemplateType? @relation(fields: [type], references: [id], onDelete: Cascade)

    @@map("email_template")
}

model emailTemplateType {
    id                  Int                   @unique @default(autoincrement()) @map("id")
    name                String                @map("name") @db.VarChar(100)
    createAt            DateTime              @default(now()) @map("created_At") @db.Timestamptz()
    updateAt            DateTime              @default(now()) @map("updated_At") @db.Timestamptz()
    templateUsedId      String?               @map("template_used_id") @db.VarChar(100)
    emailTemplateFields emailTemplateFields[]
    emailTemplate       emailTemplate[]

    @@map("email_template_type")
}

model emailTemplateFields {
    id                Int                @unique @default(autoincrement()) @map("id")
    name              String             @map("name") @db.VarChar(100)
    description       String?            @map("description") @db.VarChar(250)
    createAt          DateTime           @default(now()) @map("created_At")
    updateAt          DateTime           @default(now()) @map("updated_At")
    emailTemplateType emailTemplateType? @relation(fields: [idTemplateType], references: [id], onDelete: Cascade)
    idTemplateType    Int?               @map("id_template_type")

    @@map("email_template_fields")
}

model slideImage {
    id            Int       @unique @default(autoincrement()) @map("id")
    fileId        String    @unique @default(uuid()) @map("file_id") @db.VarChar(50)
    filePath      String?   @map("file_path") @db.VarChar(255)
    fileName      String?   @default("") @map("file_name") @db.VarChar(255)
    fileType      String?   @map("file_type") @db.VarChar(50)
    status        Boolean   @default(true) @map("status") @db.Boolean
    createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
    createdById   String?   @map("created_by_id") @db.VarChar(50)
    createdByName String?   @map("created_by_name") @db.VarChar(255)
    updatedAt     DateTime? @map("updated_at") @db.Timestamptz()
    updatedById   String?   @map("updated_by_id") @db.VarChar(50)
    updatedByName String?   @map("updated_by_name") @db.VarChar(255)
    order         Int?      @map("order")

    @@map("slide_image")
}

model masterActionStatus {
    id     Int    @unique @default(autoincrement()) @map("id")
    nameEn String @map("name_th") @db.VarChar(100)
    nameTh String @map("name_en") @db.VarChar(100)

    @@map("master_action_status")
}

model masterObjective {
    id          Int      @unique @default(autoincrement()) @map("id")
    name        String   @map("name") @db.VarChar(50)
    status      Boolean  @default(true) @map("status") @db.Boolean
    description String   @default("") @map("description") @db.Text
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @default(now()) @map("updated_at")

    @@map("master_objective")
}

model masterPosition {
    id               Int                @unique @default(autoincrement()) @map("id")
    posId            Int                @unique @default(autoincrement()) @map("pos_id")
    nameTh           String?            @default("") @map("name_th") @db.VarChar(100)
    nameEn           String?            @default("") @map("name_en") @db.VarChar(100)
    createdAt        DateTime?          @default(now()) @map("created_at")
    updatedAt        DateTime?          @default(now()) @map("updated_at")
    user             users[]
    employeeProfiles employeeProfiles[]

    @@map("master_position")
}

model masterTypeleave {
    id                   Int                    @unique @default(autoincrement()) @map("id")
    typeId               Int?                   @default(autoincrement()) @map("type_id") @db.Integer
    typeName             String?                @map("type_name") @db.VarChar(250)
    forwardLeave         String?                @map("forward_leave") @db.VarChar(250)
    limitLeaveOne        String?                @map("limit_leave1") @db.VarChar(250)
    limitLeaveTwo        String?                @map("limit_leave2") @db.VarChar(250)
    limitLeaveThree      String?                @map("limit_leave3") @db.VarChar(250)
    limitLeaveFour       String?                @map("limit_leave4") @db.VarChar(250)
    descriptionLeave     String?                @map("description_leave") @db.Text
    typeEveryDay         Boolean?               @default(false) @map("type_everyday") @db.Boolean
    typeNameEn           String?                @map("type_name_en") @db.VarChar(250)
    typeNameTh           String?                @map("type_name_th") @db.VarChar(250)
    createdAt            DateTime?              @default(now()) @map("created_at")
    updatedAt            DateTime?              @default(now()) @map("updated_at")
    typeLeaveDisabledMap typeLeaveDisabledMap[]

    @@map("master_typeleave")
}

model masterHolidaysYear {
    id             Int              @unique @default(autoincrement()) @map("id")
    holidaysYear   String           @map("holidays_year")
    createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
    updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
    masterHolidays masterHolidays[]

    @@map("master_holidays_year")
}

model masterHolidays {
    id                   Int                @unique @default(autoincrement()) @map("id")
    holidaysName         String             @map("holidays_name") @db.VarChar(250)
    masterHolidaysYearId Int                @map("master_holidays_year_id")
    holidaysDate         DateTime           @map("holidays_date") @db.Timestamptz()
    createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz()
    updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
    masterHolidaysYear   masterHolidaysYear @relation(fields: [masterHolidaysYearId], references: [id])

    @@map("master_holidays")
}

model masterRole {
    id       Int    @unique @default(autoincrement()) @map("id")
    roleCode String @map("role_code") @db.VarChar(20)
    roleName String @map("role_name") @db.VarChar(50)

    @@map("master_role")
}

model masterRule {
    id             Int              @unique @default(autoincrement()) @map("id")
    ruleCode       String           @unique @default(uuid()) @map("rule_code") @db.VarChar(50)
    ruleName       String           @map("rule_name") @db.VarChar(50)
    createdAt      DateTime         @default(now()) @map("created_at")
    updatedAt      DateTime         @default(now()) @map("updated_at")
    description    String           @default("") @map("description") @db.Text
    profileRuleMap profileRuleMap[]

    @@map("master_rule")
}

model notiActionLogs {
    id           Int      @unique @default(autoincrement()) @map("id")
    sendUserId   String?  @map("send_user_id") @db.VarChar(50)
    sendUserName String?  @map("send_user_name") @db.VarChar(255)
    toGroupIds   String[] @map("to_group_ids")
    createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
    updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()
    refId        Int      @map("ref_id")
    type         String?  @map("type") @db.VarChar(20) //leave ,expense ,bookingroom ,macar ,ma ,housekeeper
    action       String?  @map("action") @db.VarChar(20)
    notiStatus   String?  @map("noti_status") @db.VarChar(20)

    @@map("noti_action_logs")
}

model organized {
    id                        Int                         @unique @default(autoincrement()) @map("id")
    organizedId               String                      @unique @default(uuid()) @map("organized_id") @db.VarChar(50)
    organizedName             String                      @map("organized_name") @db.VarChar(50)
    description               String                      @default("") @map("description") @db.Text
    createdAt                 DateTime                    @default(now()) @map("created_at")
    updatedAt                 DateTime                    @default(now()) @map("updated_at")
    userGroup                 userGroup[]
    userRole                  userRole[]
    userMapOrganizeGroup      userMapOrganizeGroup[]
    userMapOrganizeGroupOwner userMapOrganizeGroupOwner[]
    organizeMapGroup          organizeMapGroup[]
}

model profileRule {
    id               Int              @unique @default(autoincrement()) @map("id")
    profileId        String           @unique @default(uuid()) @map("profile_id") @db.VarChar(50)
    profileName      String           @map("profile_name") @db.VarChar(50)
    createdAt        DateTime         @default(now()) @map("created_at")
    updatedAt        DateTime         @default(now()) @map("updated_at")
    description      String           @default("") @map("description") @db.Text
    roleProfileMap   roleProfileMap[]
    profileRuleMap   profileRuleMap[]
    organizedGroupId String?          @map("organized_group_id")

    @@map("profile_rule")
}

model profileRuleMap {
    id            Int          @unique @default(autoincrement()) @map("id")
    masterRule    masterRule?  @relation(fields: [masterRuleId], references: [ruleCode], onDelete: Cascade)
    masterRuleId  String?      @map("master_rule_id")
    profileRule   profileRule? @relation(fields: [profileRuleId], references: [profileId], onDelete: Cascade)
    profileRuleId String?      @map("profile_rule_id")

    @@map("profile_rule_map")
}

//
model publicizeSlideImages {
    id           Int       @unique @default(autoincrement())
    fileCode     String?   @map("file_code") @db.VarChar(200)
    path         String?   @db.VarChar(200)
    fileName     String?   @map("file_name") @db.VarChar(200)
    fileType     String?   @map("file_type") @db.VarChar(200)
    name         String?   @map("name") @db.VarChar(200)
    activeStatus Boolean   @default(false) @map("active_status") @db.Boolean
    type         String?   @db.VarChar(10)
    createdAt    DateTime  @default(now())
    updatedAt    DateTime? @db.Timestamp()

    @@map("publicize_slide_images")
}

model roleProfileMap {
    id            Int          @unique @default(autoincrement()) @map("id")
    userRole      userRole?    @relation(fields: [userRoleId], references: [roleId], onDelete: Cascade)
    userRoleId    String?      @map("user_role_id")
    profileRule   profileRule? @relation(fields: [profileRuleId], references: [profileId], onDelete: Cascade)
    profileRuleId String?      @map("profile_rule_id")
    user          users?       @relation(fields: [userId], references: [id])
    userId        Int?         @map("user_id")

    @@map("role_profile_map")
}

model typeLeaveDisabledMap {
    id                Int              @unique @default(autoincrement()) @map("id")
    user              users?           @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId            Int?             @map("user_id")
    masterTypeleave   masterTypeleave? @relation(fields: [masterTypeleaveId], references: [id], onDelete: Cascade)
    masterTypeleaveId Int?             @map("master_type_leave_id")

    @@map("type_leave_disabled_map")
}

model users {
    id                        Int                         @unique @default(autoincrement()) @map("id")
    userId                    String                      @unique @default(uuid()) @map("user_id") @db.VarChar(50)
    username                  String                      @map("username") @db.VarChar(100)
    password                  String                      @map("password") @db.Text
    firstNameTh               String?                     @map("first_name_th") @db.VarChar(100)
    lastNameTh                String?                     @map("last_name_th") @db.VarChar(100)
    firstNameEn               String?                     @map("first_name_en") @db.VarChar(100)
    lastNameEn                String?                     @map("last_name_en") @db.VarChar(100)
    email                     String?                     @map("email") @db.VarChar(100)
    phoneNumber               String?                     @map("phone_number") @db.VarChar(50)
    activeStatus              Boolean                     @default(true) @map("active_status") @db.Boolean
    clientId                  String?                     @map("client_id") @db.VarChar(50)
    createdAt                 DateTime                    @default(now()) @map("created_at")
    updatedAt                 DateTime                    @default(now()) @map("updated_at")
    organizedGroupId          String?                     @map("organized_group_id") @db.VarChar(50)
    refreshToken              String?                     @map("refresh_token")
    departmentId              Int?                        @map("department_id")
    ownerGroupId              String?                     @map("owner_group_id") @db.VarChar(50)
    imageId                   String?                     @map("image_id") @db.VarChar(255)
    userType                  String?                     @map("user_type") @db.VarChar(50)
    token                     String?                     @map("token") @db.VarChar(50)
    dataModule                String?                     @map("data_module") @db.VarChar(50)
    ownerGroup                userGroup?                  @relation(fields: [ownerGroupId], references: [groupId])
    masterPosition            masterPosition?             @relation(fields: [positionId], references: [posId])
    department                departMent?                 @relation(fields: [departmentId], references: [id])
    startWork                 DateTime?                   @map("start_work")
    ldapQuery                 String?                     @map("ldap_query")
    // userGroupMap              userGroupMap[]
    roleProfileMap            roleProfileMap[]
    userRoleMap               userRoleMap[]
    positionId                Int?
    userMapOrganizeChart      userMapOrganizeChart[]
    typeLeaveDisabledMap      typeLeaveDisabledMap[]
    userMapOrganizeGroup      userMapOrganizeGroup[]
    userMapOrganizeGroupOwner userMapOrganizeGroupOwner[]
}

model userMapOrganizeGroup {
    id          Int        @unique @default(autoincrement()) @map("id")
    users       users?     @relation(fields: [usersId], references: [userId])
    usersId     String?    @map("user_id")
    organized   organized? @relation(fields: [organizedId], references: [organizedId], onDelete: Cascade)
    organizedId String?    @map("organized_id")
    group       userGroup? @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
    groupId     String?

    @@map("user_map_organize")
}

model userMapOrganizeGroupOwner {
    id           Int        @unique @default(autoincrement()) @map("id")
    users        users?     @relation(fields: [usersId], references: [userId], onDelete: Cascade)
    usersId      String?    @map("user_id")
    organized    organized? @relation(fields: [organizedId], references: [organizedId])
    organizedId  String?    @map("organized_id")
    group        userGroup? @relation(fields: [ownerGroupId], references: [groupId], onDelete: Cascade)
    ownerGroupId String?    @map("owner_group_id")

    @@map("organize_map_groupowner")
}

model organizeMapGroup {
    id          Int        @unique @default(autoincrement()) @map("id")
    organized   organized? @relation(fields: [organizedId], references: [organizedId])
    organizedId String?    @map("organize_id")
    group       userGroup? @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
    groupId     String?    @map("group_id")

    @@map("organize_map_group")
}

model userGroup {
    id                        Int                         @unique @default(autoincrement()) @map("id")
    groupId                   String                      @unique @default(uuid()) @map("group_id") @db.VarChar(50)
    groupName                 String                      @map("group_name") @db.VarChar(200) //Text waiting update
    createdAt                 DateTime                    @default(now()) @map("created_at")
    updatedAt                 DateTime                    @default(now()) @map("updated_at")
    parent                    userGroup?                  @relation("ChildGroup", fields: [parentGroupId], references: [groupId])
    parentGroupId             String?                     @map("parent_group_id") @db.VarChar(50)
    userGroup                 userGroup[]                 @relation("ChildGroup")
    // userGroupMap              userGroupMap[]
    organized                 organized?                  @relation(fields: [organizedGroupId], references: [organizedId], onDelete: Cascade)
    organizedGroupId          String?                     @map("organized_group_id")
    description               String                      @default("") @map("description") @db.Text
    user                      users[]
    userMapOrganizeGroup      userMapOrganizeGroup[]
    userMapOrganizeGroupOwner userMapOrganizeGroupOwner[]
    organizeMapGroup          organizeMapGroup[]

    // saleUserGroupId        String[]                 @map("sale_user_group_id")
    // saleUsersId            String[]                 @map("sale_users_id")
    // engineerUserGroupId    String[]                 @map("engineer_user_group_id")
    // engineerUsersId        String[]                 @map("engineer_users_id")
    // exceptionalSatatus     Boolean?                 @default(false) @map("exceptional_satatus")
    userGroupUserRoleMap userGroupUserRoleMap[]
    userPermissionGroup  userPermissionGroup[]
    employeeProfiles     employeeProfiles[]

    @@map("user_group")
}

model userPermissionGroup {
    id                 Int         @unique @default(autoincrement()) @map("id")
    userGroupId        String      @map("user_group_id")
    //leave ,expense ,bookingroom ,macar ,ma ,housekeeper
    userGroup          userGroup?  @relation(fields: [userGroupId], references: [groupId], onDelete: Cascade)
    permissionGroupIds String[]    @map("permission_group_ids")
    userModule         userModule? @relation(fields: [userModuleId], references: [id])
    userModuleId       Int?        @map("user_module_id")

    @@map("user_permission_group")
}

model userGroupUserRoleMap {
    id          Int       @unique @default(autoincrement()) @map("id")
    userGroup   userGroup @relation(fields: [userGroupId], references: [groupId], onDelete: Cascade)
    userRole    userRole  @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
    userGroupId String    @map("user_group_id")
    roleId      String    @map("role_id")

    @@map("user_group_user_role_map")
}

model userModule {
    id                  Int                   @unique @default(autoincrement()) @map("id")
    code                String                @unique @map("code") @db.VarChar(200)
    name                String                @map("name") @db.VarChar(200)
    status              Boolean               @default(true) @map("status") @db.Boolean
    description         String?               @map("description") @db.Text
    userPermissionGroup userPermissionGroup[]

    @@map("user_module")
}

model userRole {
    id               Int           @unique @default(autoincrement()) @map("id")
    roleId           String        @unique @default(uuid()) @map("role_id") @db.VarChar(50)
    roleName         String        @map("role_name") @db.VarChar(50)
    createdAt        DateTime      @default(now()) @map("created_at")
    updatedAt        DateTime      @default(now()) @map("updated_at")
    description      String        @default("") @map("description") @db.Text
    userRoleMap      userRoleMap[]
    organized        organized?    @relation(fields: [organizedGroupId], references: [organizedId])
    organizedGroupId String?       @map("organized_group_id")

    roleProfileMap       roleProfileMap[]
    userGroupUserRoleMap userGroupUserRoleMap[]

    @@map("user_role")
}

model userRoleMap {
    id         Int       @unique @default(autoincrement()) @map("id")
    userRole   userRole? @relation(fields: [userRoleId], references: [roleId], onDelete: Cascade)
    userRoleId String?   @map("user_role_id")
    user       users?    @relation(fields: [userId], references: [userId], onDelete: Cascade)
    userId     String?   @map("user_id")

    @@map("user_role_map")
}

model floor {
    id                Int                 @unique @default(autoincrement()) @map("id")
