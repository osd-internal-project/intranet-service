model masterProvinceThailand {
  id             Int       @unique @default(autoincrement()) @map("id")
  provinceId     String?   @unique @default(uuid()) @map("province_id") @db.VarChar(50)
  nameProvinceTH String    @map("name_province_th") @db.VarChar(50)
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @map("updated_at")

  @@map("master_province_thailand")
}

model employeeProperty {
  id           Int            @unique @default(autoincrement()) @map("id")
  userId       String         @map("user_id") @db.VarChar(50)
  type         String         @db.VarChar(100)
  name         String         @db.VarChar(255)
  nameOther    String?        @map("name_other") @db.VarChar(255)
  brand        String         @db.VarChar(255)
  serial       String         @db.VarChar(255)
  assetNumber  String         @map("asset_number") @db.VarChar(255)
  address      String         @db.VarChar(500)
  assetStatus  String         @map("asset_status") @db.VarChar(50)
  pathImage    String         @map("path_image") @db.VarChar(255)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @map("updated_at")
  users        users          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  mistakesType mistakesType[]

  @@map("employee_property")
}

model mistakesType {
  id                 Int               @unique @default(autoincrement()) @map("id")
  typeId             String            @unique @default(uuid()) @map("type_id") @db.VarChar(50)
  typeName           String            @map("type_name") @db.VarChar(255)
  detail             String            @db.VarChar(500)
  status             Boolean           @default(true)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @map("updated_at")
  employeePropertyId Int?              @map("employee_property_id")
  employeeProperty   employeeProperty? @relation(fields: [employeePropertyId], references: [id])

  @@map("mistakes_type")
}

model complainProblem {
  id        Int       @unique @default(autoincrement()) @map("id")
  name      String    @map("name") @db.VarChar(255)
  userId    String    @map("user_id") @db.VarChar(50)
  detail    String    @db.VarChar(500)
  status    Boolean?  @default(false)
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @map("updated_at")
  updatedBy String?   @map("updated_by") @db.VarChar(255)
  users     users?    @relation(fields: [userId], references: [userId])

  @@map("complain_problem")
}
