  updatedAt          DateTime             @default(now()) @map("updated_at")
  masterProductImage masterProductImage[]
  unit               unit?                @relation(fields: [unitId], references: [id])
  unitId             Int?
  order              order[]
  requestOrderList   requestOrderList[]

  @@map("master_product")
}

model masterProductImage {
  id              Int            @unique @default(autoincrement()) @map("id")
  prdImageId      String         @unique @default(uuid()) @map("image_id") @db.VarChar(50)
  fileName        String?        @map("file_name") @db.VarChar(150)
  filePath        String?        @map("file_path") @db.VarChar(150)
  fileType        String?        @map("file_type") @db.VarChar(150)
  createdAt       DateTime?      @default(now()) @map("created_at")
  updatedAt       DateTime?      @default(now()) @map("updated_at")
  masterProductId String?        @map("master_product_id")
  masterProduct   masterProduct? @relation(fields: [masterProductId], references: [prdId], onDelete: Cascade)

  @@map("master_product_image")
}

model unit {
  id            Int             @unique @default(autoincrement()) @map("id")
  unitID        String          @unique @default(uuid()) @map("unit_id")
  unitName      String          @default("") @map("unit_name") @db.VarChar(100)
  status        Boolean?        @default(true) @map("active") @db.Boolean
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @map("updated_at")
  masterProduct masterProduct[]
}

model order {
  id              Int            @unique @default(autoincrement()) @map("id")
  oderId          String?        @unique @default(uuid()) @map("order_id") @db.VarChar(50)
  prdId           String         @map("product_id") @db.VarChar(50)
  prdName         String         @map("product_name") @db.VarChar(250)
  price           Float          @default(0.00) @map("price")
  cost            Float?         @default(0.00) @map("cost")
  avgCost         Float?         @default(0.00) @map("avg_cost")
  totalPrice      Float          @default(0.00) @map("total_price")
  totalQty        Float          @default(0.00) @map("total_qty")
  unit            String?        @map("unit") @db.VarChar(20)
  updatedBy       String         @map("updated_by") @db.VarChar(250)
  createdAt       DateTime?      @default(now()) @map("created_at")
  updatedAt       DateTime?      @default(now()) @map("updated_at")
  status          String?        @default("in-stock") @map("status") @db.VarChar(50)
  masterProductId String?        @map("master_product_id")
  masterProduct   masterProduct? @relation(fields: [masterProductId], references: [prdId], onDelete: Cascade)
  // orderLot        orderLot[]
}

model requestOrder {
  id             Int                @unique @default(autoincrement()) @map("id")
  requestId      String             @unique @default(uuid()) @map("request_id") @db.VarChar(50)
  requestPrice   Float              @map("request_price")
  requestQty     Int?               @default(0) @map("request_qty")
  requester      String?            @map("requester") @db.VarChar(100)
  requestDate    DateTime           @map("request_date")
  object         String?            @map("object") @db.VarChar(250)
  status         String?            @default("new") @map("status") @db.VarChar(50)
  remark         String?            @map("remark") @db.Text()
  approvedBy     String?            @map("approved_by")
  approvedAt     DateTime?          @map("approved_at")
  approvedDetail String?            @map("approved_detail") @db.Text()
  createdBy      String             @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @default(now()) @map("updated_at")
  requestList    requestOrderList[]

  @@map("request_order")
}

model requestOrderList {
  id              Int            @unique @default(autoincrement()) @map("id")
  requestId       String?        @map("request_id")
  requestOrder    requestOrder?  @relation(fields: [requestId], references: [requestId])
  masterProductId String?        @map("master_product_id")
  qty             Int?           @map("qty")
  amount          Int            @map("amount") @db.Integer
  masterProduct   masterProduct? @relation(fields: [masterProductId], references: [prdId])

  @@map("request_order_list")
}

