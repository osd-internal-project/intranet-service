model user {
    id               Int              @unique @default(autoincrement()) @map("id")
    userId           String           @unique @default(uuid()) @map("user_id") @db.VarChar(50)
    username         String           @map("username") @db.VarChar(100)
    password         String           @map("password") @db.Text
    firstNameTh      String?          @map("first_name_th") @db.VarChar(100)
    lastNameTh       String?          @map("last_name_th") @db.VarChar(100)
    firstNameEn      String?          @map("first_name_en") @db.VarChar(100)
    lastNameEn       String?          @map("last_name_en") @db.VarChar(100)
    email            String?          @map("email") @db.VarChar(100)
    phoneNumber      String?          @map("phone_number") @db.VarChar(50)
    activeStatus     Boolean          @default(true) @map("active_status") @db.Boolean
    clientId         String?          @map("client_id") @db.VarChar(50)
    createdAt        DateTime         @default(now()) @map("created_at")
    updatedAt        DateTime         @default(now()) @map("updated_at")
    masterPosition   masterPosition?  @relation(fields: [masterPositionId], references: [id])
    masterPositionId Int?             @map("master_position_id")
    userGroupMap     userGroupMap[]
    roleProfileMap   roleProfileMap[]
    userRoleMap      userRoleMap[]
    organizedGroupId String?          @map("organized_group_id") @db.VarChar(50)
    refreshToken     String?          @map("refresh_token")
    ownerGroupId     String?          @map("owner_group_id") @db.VarChar(50)
    ownerGroup       userGroup?       @relation(fields: [ownerGroupId], references: [groupId])
    request          request[]
    // userOwner        userOwner[]
}

